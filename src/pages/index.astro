---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Note from '~/components/widgets/Note.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import ProjetosSlider from '../components/widgets/ProjetosSlider.astro';
const metadata = {
  title: 'Sara Pereira - Arquitetura',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
 <!--
  <Hero
    image={{ src: '~/assets/images/citys.png', alt: 'AstroWind Hero Image' }}> 
    <Fragment slot="subtitle">
      <span class="hidden sm:inline">
        <span class="font-semibold"></span
      >
      <span class="block mb-1 sm:hidden font-bold text-blue-600">AstroWind: Production-ready.</span>
      
    </Fragment>
    
  </Hero>
 -->

  <!-- Features Widget *************** -->

  <Features
    id="features"
    title="Serviços"
    subtitle="Desenvolvemos projetos adequados à necessidade de cada cliente. <br/>Desde levantamentos arquitetonicos, projetos de remodelação, projetos de raíz, projetos de execução e design de interiores"
    items={[
      {
        title: 'Levantamentos arquitetonicos',
        description:
          'O levantamento arquitetónico é fundamental para a realização de intervenções em edifícios, como reabilitação, ampliação e remodelação.<br/> E ainda, para efeitos de atualização do modelo 1 do IMI (atualização de áreas)',
      },
      {
        title: 'Projetos de remodelação',
        description:
          'Sempre com a premissa de respeitar o existente, procuramos desenvolver projetos que se transformem em espaços mais funcionais e e acolhedores',
      },
      {
        title: 'Projetos de arquitetura',
        description:
          'Elaboramos projetos de raíz adaptados às necessidades de cada cliente, em que cada projeto seja um transformar de um sonho em realidade',
      },
      {
        title: 'Projetos de execução',
        description:
          'Elaboramos projetos de execução que consistem na elaboração de desenhos técnicos, assim como escolha de acabamentos e execução de lista de materiais',
      },
      {
        title: 'Design de interiores',
        description:
          "Em parceria com uma designer de interiores, desenvolvemos projetos de decoração, para que cada espaço se torne único e acolhedor",
      },
      {
        title: 'Consultoria',
        description:
          'Desde projetos de remodelação a interpretações de pdm'
      },
    ]}
  />

  <!-- Content Widget **************** -->

<section id="projetos" class="inset-0 bg-blue-50 dark:bg-transparent">
  <div class="container mx-auto">
    <h2 class="text-3xl font-bold text-center text-gray-800 dark:text-white mb-6">Projetos</h2>
    <ProjetosSlider />
  </div>
</section>


  <!-- HighlightedPosts Widget ******* -->
 <!--
  <BlogLatestPosts
    title="Find out more content in our Blog"
    information={`The blog is used to display AstroWind documentation.
                        Each new article will be an important step that you will need to know to be an expert in creating a website using Astro + Tailwind CSS.
                        Astro is a very interesting technology. Thanks.
                `}
  />
-->

  <!-- Features2 Widget ************** -->

  <Features2
    title="Contactos"
    id="contactos"
    subtitle=""
    tagline=""

     items={[
      {
        title: 'Phone',
        description: '+351 913 993 165',
        icon: 'tabler:headset',
      },
      {
        title: 'Email',
        description: 'sarapereira.arquitetura@hotmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'Localização',
        description: 'Tomar',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Instagram',
        description: '<a  target="_blank" href="https://www.instagram.com/sarapereira.arquitetura" class="text-blue-600 hover:underline">sarapereira.arquitetura</a>',
        icon: 'tabler:brand-instagram'
      },
      {
        title: 'Facebook',
        description:
          "Sara Pereira",
        icon: 'tabler:brand-facebook',
      },
      {
        title: 'Linkedin',
        description:
          "Sara Pereira",
        icon: 'tabler:brand-linkedin',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-white-50 dark:bg-transparent"></div>
    </Fragment>
  </Features2>



 <Content
    id="sobre"
    items={[
      {
        title: 'Sobre mim',
        description: `Desde pequena que o meu sonho era criar e mudar casas, tanto que as minhas brincadeiras preferidas eram construir cabanas e fazer legos.<br/><br/>
        Após ingressar no curso de arquitetura e fazer erasmus em Veneza, aprendi que é necessário valorizar e respeitar o que está feito.<br/><br/>
        Deste modo procuro inovar seempre, mas com respeito no pré-existente.`,
      },
    ]}
    image={{
      src: '~/assets/images/sobre.jpeg',
      alt: 'Steps image',
    }}
  >
    

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

