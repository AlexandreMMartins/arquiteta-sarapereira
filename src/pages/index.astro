---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';

import portrait from '~/assets/images/sobre-v2.png';
import serviceArchitecture from '~/assets/images/services/arquitetura.png';
import serviceConsulting from '~/assets/images/services/consultoria.png';
import serviceExecution from '~/assets/images/services/execucao.png';
import serviceInteriors from '~/assets/images/services/interiores.png';
import serviceSurvey from '~/assets/images/services/levantamentos.png';
import serviceRemodel from '~/assets/images/services/remodelacao.png';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Sara Pereira — Arquitetura',
  description:
    'Projetos de arquitetura, remodelação e interiores em Tomar, pensados para transformar espaços com respeito pelo que já existe.',
  ignoreTitleTemplate: true,
};

const services = [
  {
    number: '01',
    title: 'Levantamentos arquitetónicos',
    description: 'Levantamentos rigorosos para reabilitação, ampliação, remodelação e atualização de áreas no IMI.',
    detail:
      'Registamos o espaço existente com rigor para criar uma base segura para todas as decisões seguintes. O levantamento pode incluir medição, desenho técnico e organização da informação necessária ao projeto.',
    highlights: ['Medição do existente', 'Desenhos de levantamento', 'Atualização de áreas'],
    image: serviceSurvey,
  },
  {
    number: '02',
    title: 'Projetos de remodelação',
    description:
      'Espaços mais funcionais e acolhedores, desenhados a partir da identidade e das qualidades do existente.',
    detail:
      'Partimos das qualidades da casa e da forma como é vivida para reorganizar circulações, luz, arrumação e materiais. Cada intervenção procura melhorar o quotidiano sem apagar a memória do lugar.',
    highlights: ['Estudo de soluções', 'Reorganização funcional', 'Escolha de materiais'],
    image: serviceRemodel,
  },
  {
    number: '03',
    title: 'Projetos de arquitetura',
    description: 'Projetos de raiz adaptados ao lugar, ao orçamento e à forma como cada cliente deseja viver.',
    detail:
      'Desenvolvemos o projeto desde o conceito inicial até ao licenciamento, articulando programa, implantação, conforto e linguagem arquitetónica numa solução coerente e possível de construir.',
    highlights: ['Estudo prévio', 'Licenciamento', 'Coordenação do projeto'],
    image: serviceArchitecture,
  },
  {
    number: '04',
    title: 'Projetos de execução',
    description:
      'Desenhos técnicos, definição de acabamentos e listas de materiais para uma obra clara e bem preparada.',
    detail:
      'Transformamos o projeto em informação precisa para a obra. Detalhes construtivos, mapas de acabamentos e especificações reduzem dúvidas, apoiam orçamentos e protegem a intenção do projeto.',
    highlights: ['Detalhes construtivos', 'Mapas de acabamentos', 'Listas de materiais'],
    image: serviceExecution,
  },
  {
    number: '05',
    title: 'Design de interiores',
    description: 'Ambientes únicos e coerentes, desenvolvidos em parceria com profissionais de design de interiores.',
    detail:
      'Criamos ambientes completos onde mobiliário, iluminação, cor e textura trabalham em conjunto. O objetivo é que cada divisão seja confortável, pessoal e coerente com a arquitetura da casa.',
    highlights: ['Conceito de interiores', 'Mobiliário e iluminação', 'Paleta de materiais'],
    image: serviceInteriors,
  },
  {
    number: '06',
    title: 'Consultoria',
    description:
      'Apoio técnico em decisões de remodelação, viabilidade, leitura de PDM e primeiros passos de um projeto.',
    detail:
      'Uma sessão de consultoria ajuda a esclarecer possibilidades antes de avançar. Analisamos condicionantes, prioridades e próximos passos para que possa decidir com mais segurança.',
    highlights: ['Análise de viabilidade', 'Leitura de PDM', 'Orientação inicial'],
    image: serviceConsulting,
  },
];

const steps = [
  ['Conversamos', 'Percebemos o espaço, as necessidades, o orçamento e aquilo que imagina para o futuro.'],
  ['Desenhamos', 'Transformamos essas ideias numa proposta clara, funcional e sensível ao lugar.'],
  ['Acompanhamos', 'Preparamos a execução e ajudamos a manter cada decisão alinhada com o projeto.'],
];
---

<Layout metadata={metadata}>
  <section class="hero-shell overflow-hidden">
    <div
      class="mx-auto grid min-h-[calc(100vh-72px)] max-w-7xl items-center gap-14 px-5 py-20 md:px-8 lg:grid-cols-[1.2fr_0.8fr] lg:py-24"
    >
      <div class="hero-copy relative z-10 max-w-3xl">
        <h1 class="hero-title text-[clamp(3.6rem,9vw,8.4rem)] font-medium leading-[0.98] tracking-[-0.065em] text-stone-950 md:leading-[0.86]">
          <span class="hero-line"><span>Espaços com</span></span>
          <span class="hero-line"><span>memória e futuro.</span></span>
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-stone-600 md:text-xl">
          Projetos atentos ao que já existe e à forma como cada pessoa vive — do primeiro esboço ao último detalhe.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="#contactos">Falar sobre um projeto</a>
          <a class="btn btn-secondary" href="#servicos">Conhecer os serviços</a>
        </div>
      </div>

      <div class="hero-portrait relative mx-auto w-full max-w-md -translate-y-5 lg:max-w-none lg:-translate-y-8">
        <div
          class="hero-portrait-frame relative mx-auto aspect-[4/5] w-[88%] overflow-hidden rounded-t-[11rem] bg-[#e9dfd0] shadow-xl shadow-stone-900/10"
        >
          <Image
            src={portrait}
            alt="Sara Pereira, arquiteta"
            class="parallax-image h-full w-full object-cover object-center"
            data-parallax
            data-parallax-strength="0.55"
            widths={[420, 640, 840]}
            sizes="(max-width: 1024px) 80vw, 32vw"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </section>

  <section id="sobre" class="scroll-mt-24 bg-[#1f2825] text-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-5 py-20 md:px-8 md:py-28 lg:grid-cols-[0.7fr_1.3fr]">
      <div data-reveal="left">
        <p class="eyebrow eyebrow-light">Sobre</p>
        <p class="mt-6 max-w-xs text-sm leading-relaxed text-stone-400">
          Uma prática próxima, orientada pela curiosidade, pela função e pelo respeito pelo contexto.
        </p>
      </div>
      <div>
        <h2
          class="max-w-4xl text-4xl font-medium leading-tight tracking-[-0.035em] md:text-6xl"
          data-reveal="right"
          data-reveal-repeat
        >
          “Desde pequena que o meu sonho era criar e transformar casas.”
        </h2>
        <div class="mt-10 grid gap-6 text-base leading-relaxed text-stone-300 md:grid-cols-2 md:text-lg">
          <p>
            Da construção de cabanas e dos Legos nasceu uma vontade que se tornou profissão. A formação em arquitetura e
            a experiência de Erasmus em Veneza reforçaram uma convicção: antes de intervir, é preciso compreender e
            valorizar o que já está feito.
          </p>
          <p>
            É desse equilíbrio que parte cada projeto — inovar sem apagar, melhorar sem descaracterizar e criar lugares
            acolhedores, funcionais e profundamente ligados a quem os habita.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section id="servicos" class="scroll-mt-24 bg-[#f3f0e9]">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-end">
        <div data-reveal="left" data-reveal-repeat>
          <p class="eyebrow">Serviços</p>
          <h2 class="mt-6 text-4xl font-medium tracking-[-0.04em] text-stone-950 md:text-6xl">
            Do espaço existente<br /> à ideia construída.
          </h2>
        </div>
        <p data-reveal="right" class="max-w-lg text-lg leading-relaxed text-stone-600 lg:justify-self-end">
          Cada projeto começa com uma leitura atenta das necessidades, do lugar e dos recursos disponíveis.
        </p>
      </div>

      <div class="mt-14 grid border-t border-stone-300 md:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service, index) => (
            <a
              href="#detalhes-servicos"
              data-service-trigger={index}
              data-reveal="up"
              style={`--reveal-delay: ${(index % 3) * 90}ms`}
              class="service-card group block border-b border-stone-300 py-8 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#8c4c2f] focus-visible:ring-inset md:px-7 md:even:border-l lg:border-l lg:first:border-l-0"
              aria-label={`Ver detalhes de ${service.title}`}
            >
              <div class="flex items-start justify-end">
                <Icon
                  name="tabler:arrow-down-right"
                  class="h-5 w-5 text-stone-400 transition group-hover:translate-x-1 group-hover:translate-y-1 group-hover:text-[#ab5c36]"
                />
              </div>
              <h3 class="mt-10 text-2xl font-medium tracking-tight text-stone-900">{service.title}</h3>
              <p class="mt-4 leading-relaxed text-stone-600">{service.description}</p>
              <span class="mt-6 inline-block text-sm font-semibold text-[#8c4c2f] opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100">
                Explorar serviço
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="detalhes-servicos" class="scroll-mt-8 bg-[#1f2825] text-white" data-services-carousel>
    <div class="mx-auto max-w-7xl px-5 py-16 md:px-8 md:py-20">
      <div class="mb-8 flex items-end justify-between gap-6" data-reveal="up" data-reveal-repeat>
        <div>
          <p class="eyebrow eyebrow-light">Em detalhe</p>
          <p class="mt-4 max-w-md text-stone-400">
            Explore cada serviço e descubra como podemos acompanhar o seu projeto.
          </p>
        </div>
        <div class="hidden items-center gap-3 sm:flex">
          <button class="carousel-arrow" type="button" data-carousel-prev aria-label="Serviço anterior">
            <Icon name="tabler:arrow-left" class="h-5 w-5" />
          </button>
          <button class="carousel-arrow" type="button" data-carousel-next aria-label="Serviço seguinte">
            <Icon name="tabler:arrow-right" class="h-5 w-5" />
          </button>
        </div>
      </div>

      <div class="service-carousel-stage" data-reveal="up" style="--reveal-delay: 100ms">
        {
          services.map((service, index) => (
            <article
              data-service-slide
              hidden={index !== 0}
              aria-roledescription="slide"
              aria-label={`${index + 1} de ${services.length}`}
            >
              <div class="grid overflow-hidden rounded-sm bg-[#29332f] lg:grid-cols-[1.05fr_0.95fr]">
                <div class="service-media aspect-[4/3] overflow-hidden lg:aspect-auto lg:min-h-[28rem]">
                  <Image
                    src={service.image}
                    alt={`Ambiente representativo de ${service.title.toLowerCase()}`}
                    class="parallax-image h-full w-full object-cover"
                    data-parallax
                    data-parallax-strength="0.35"
                    widths={[640, 960, 1280]}
                    sizes="(max-width: 1024px) 100vw, 55vw"
                  />
                </div>
                <div class="flex flex-col justify-between p-7 md:p-8 lg:p-10">
                  <div>
                    <h3 class="text-3xl font-medium leading-tight tracking-[-0.035em] md:text-4xl">{service.title}</h3>
                    <p class="mt-5 text-base leading-relaxed text-stone-300 lg:text-lg">{service.detail}</p>
                    <ul class="mt-6 space-y-2.5 border-t border-white/15 pt-5">
                      {service.highlights.map((highlight) => (
                        <li class="flex items-center gap-3 text-sm text-stone-300 md:text-base">
                          <span class="h-1.5 w-1.5 rounded-full bg-[#dba480]" />
                          {highlight}
                        </li>
                      ))}
                    </ul>
                  </div>
                  <a
                    class="mt-8 inline-flex items-center gap-2 font-semibold text-[#e6b897] transition hover:gap-3"
                    href="#contactos"
                  >
                    Falar sobre este serviço
                    <Icon name="tabler:arrow-right" class="h-5 w-5" />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>

      <div class="mt-5 flex items-center justify-between gap-5">
        <div class="flex flex-wrap gap-2" role="tablist" aria-label="Escolher serviço">
          {
            services.map((service, index) => (
              <button
                type="button"
                class="carousel-dot"
                data-carousel-dot={index}
                aria-label={`Mostrar ${service.title}`}
                aria-current={index === 0 ? 'true' : 'false'}
              >
                <span class="sr-only">{service.title}</span>
              </button>
            ))
          }
        </div>
        <div class="flex items-center gap-3 sm:hidden">
          <button class="carousel-arrow" type="button" data-carousel-prev aria-label="Serviço anterior">
            <Icon name="tabler:arrow-left" class="h-5 w-5" />
          </button>
          <button class="carousel-arrow" type="button" data-carousel-next aria-label="Serviço seguinte">
            <Icon name="tabler:arrow-right" class="h-5 w-5" />
          </button>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <p class="eyebrow" data-reveal="up" data-reveal-repeat>Como trabalhamos</p>
      <div class="mt-10 grid gap-8 lg:grid-cols-3">
        {
          steps.map(([title, description], index) => (
            <article class="border-t border-stone-300 pt-6" data-reveal="up" style={`--reveal-delay: ${index * 100}ms`}>
              <span class="text-sm text-[#ab5c36]">0{index + 1}</span>
              <h3 class="mt-8 text-3xl font-medium tracking-tight text-stone-950">{title}</h3>
              <p class="mt-4 max-w-sm leading-relaxed text-stone-600">{description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section id="contactos" class="scroll-mt-24 bg-[#d9c7ad]">
    <div class="mx-auto max-w-7xl px-5 py-20 md:px-8 md:py-28">
      <p class="eyebrow" data-reveal="up">Contactos</p>
      <div class="mt-8 grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-end">
        <div data-reveal="left" data-reveal-repeat>
          <h2 class="text-[clamp(3rem,7vw,6.5rem)] font-medium leading-[0.95] tracking-[-0.055em] text-stone-950">
            Tem um espaço<br /> para transformar?
          </h2>
          <a
            class="mt-10 inline-flex items-center gap-3 text-lg font-semibold text-stone-950 underline decoration-stone-700/30 underline-offset-8 transition hover:decoration-stone-900"
            href="mailto:sarapereira.arquitetura@hotmail.com"
          >
            Conte-me a sua ideia
            <Icon name="tabler:arrow-up-right" class="h-5 w-5" />
          </a>
        </div>
        <address class="not-italic lg:justify-self-end" data-reveal="right">
          <ul class="space-y-5 text-lg text-stone-800">
            <li><a class="contact-link" href="tel:+351913993165"><Icon name="tabler:phone" /> +351 913 993 165</a></li>
            <li>
              <a class="contact-link break-all" href="mailto:sarapereira.arquitetura@hotmail.com"
                ><Icon name="tabler:mail" /> sarapereira.arquitetura@hotmail.com</a
              >
            </li>
            <li><span class="contact-link"><Icon name="tabler:map-pin" /> Tomar, Portugal</span></li>
            <li>
              <a
                class="contact-link"
                href="https://www.instagram.com/sarapereira.arquitetura"
                target="_blank"
                rel="noopener noreferrer"><Icon name="tabler:brand-instagram" /> @sarapereira.arquitetura</a
              >
            </li>
          </ul>
        </address>
      </div>
    </div>
  </section>
</Layout>

<script>
  const initializeServicesCarousel = () => {
    const carousel = document.querySelector<HTMLElement>('[data-services-carousel]');
    if (!carousel || carousel.dataset.ready === 'true') return;

    carousel.dataset.ready = 'true';
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-service-slide]'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-dot]'));
    const triggers = Array.from(document.querySelectorAll<HTMLElement>('[data-service-trigger]'));
    const previousButtons = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-prev]'));
    const nextButtons = Array.from(carousel.querySelectorAll<HTMLButtonElement>('[data-carousel-next]'));
    let currentIndex = 0;
    let timer: number | undefined;

    const startTimer = () => {
      window.clearInterval(timer);
      timer = window.setInterval(() => showSlide(currentIndex + 1, false), 6500);
    };

    const showSlide = (requestedIndex: number, restart = true) => {
      currentIndex = (requestedIndex + slides.length) % slides.length;

      slides.forEach((slide, index) => {
        slide.hidden = index !== currentIndex;
      });

      dots.forEach((dot, index) => {
        dot.setAttribute('aria-current', index === currentIndex ? 'true' : 'false');
      });

      if (restart) startTimer();
    };

    triggers.forEach((trigger) => {
      trigger.addEventListener('click', () => {
        showSlide(Number(trigger.dataset.serviceTrigger));
      });
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', () => showSlide(Number(dot.dataset.carouselDot)));
    });

    previousButtons.forEach((button) => button.addEventListener('click', () => showSlide(currentIndex - 1)));
    nextButtons.forEach((button) => button.addEventListener('click', () => showSlide(currentIndex + 1)));

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) window.clearInterval(timer);
      else startTimer();
    });

    startTimer();
  };

  initializeServicesCarousel();
  document.addEventListener('astro:page-load', initializeServicesCarousel);

  const initializePageMotion = () => {
    const elements = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-motion-ready])'));
    if (!elements.length) return;

    document.documentElement.classList.add('motion-ready');

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
      elements.forEach((element) => {
        element.dataset.motionReady = 'true';
        element.classList.add('is-visible');
      });
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const element = entry.target as HTMLElement;
          const shouldRepeat = element.hasAttribute('data-reveal-repeat');

          if (entry.isIntersecting) {
            element.classList.add('is-visible');
            if (!shouldRepeat) observer.unobserve(element);
            return;
          }

          if (shouldRepeat) element.classList.remove('is-visible');
        });
      },
      { threshold: 0.14, rootMargin: '-96px 0px -8% 0px' }
    );

    elements.forEach((element) => {
      element.dataset.motionReady = 'true';
      observer.observe(element);
    });
  };

  initializePageMotion();
  document.addEventListener('astro:page-load', initializePageMotion);

  const initializeParallax = () => {
    const root = document.documentElement;
    if (root.dataset.parallaxReady === 'true') return;

    root.dataset.parallaxReady = 'true';
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let frame: number | undefined;

    const update = () => {
      frame = undefined;
      if (reducedMotion.matches) return;

      const viewportHeight = window.innerHeight;
      const mobileMultiplier = window.innerWidth < 768 ? 0.45 : 1;

      document.querySelectorAll<HTMLElement>('[data-parallax]').forEach((element) => {
        if (element.closest('[hidden]')) return;

        const bounds = element.getBoundingClientRect();
        if (bounds.bottom < -120 || bounds.top > viewportHeight + 120) return;

        const distanceFromCenter = bounds.top + bounds.height / 2 - viewportHeight / 2;
        const progress = Math.max(-1, Math.min(1, distanceFromCenter / viewportHeight));
        const strength = Number(element.dataset.parallaxStrength ?? 0.4);
        element.style.setProperty('--parallax-y', `${progress * -44 * strength * mobileMultiplier}px`);
      });
    };

    const requestUpdate = () => {
      if (frame !== undefined) return;
      frame = window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    requestUpdate();
  };

  initializeParallax();
  document.addEventListener('astro:page-load', initializeParallax);

  const initializeSectionFeedback = () => {
    document
      .querySelectorAll<HTMLAnchorElement>(
        'a[href="#sobre"]:not([data-section-ready]), a[href="#servicos"]:not([data-section-ready]), a[href="#contactos"]:not([data-section-ready])'
      )
      .forEach((link) => {
        link.dataset.sectionReady = 'true';
        link.addEventListener('click', (event) => {
          const href = link.getAttribute('href') ?? '';
          const target = document.querySelector<HTMLElement>(href);
          if (!target) return;

          event.preventDefault();

          const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          const bounds = target.getBoundingClientRect();
          const alreadyVisible = bounds.top < window.innerHeight * 0.45 && bounds.bottom > window.innerHeight * 0.55;

          target.scrollIntoView({ behavior: reducedMotion ? 'auto' : 'smooth', block: 'start' });
          window.history.replaceState(null, '', href);

          window.setTimeout(
            () => {
              target.classList.remove('is-section-highlighted');
              void target.offsetWidth;
              target.classList.add('is-section-highlighted');
              window.setTimeout(() => target.classList.remove('is-section-highlighted'), 1100);
            },
            alreadyVisible || reducedMotion ? 0 : 520
          );
        });
      });
  };

  initializeSectionFeedback();
  document.addEventListener('astro:page-load', initializeSectionFeedback);
</script>

<style>
  .hero-shell {
    background:
      linear-gradient(90deg, transparent 49.9%, rgb(120 113 108 / 0.12) 50%, transparent 50.1%),
      linear-gradient(0deg, transparent 49.9%, rgb(120 113 108 / 0.1) 50%, transparent 50.1%), #f8f6f1;
    background-size: 120px 120px;
  }

  .hero-copy > :not(.hero-title) {
    animation: hero-copy-in 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding: 0 0.08em 0.1em 0;
    margin-bottom: -0.1em;
  }

  .hero-line > span {
    display: block;
    animation: hero-line-in 980ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .hero-line:nth-child(1) > span {
    animation-delay: 80ms;
  }

  .hero-line:nth-child(2) > span {
    animation-delay: 180ms;
  }

  .hero-copy > :nth-child(2) {
    animation-delay: 310ms;
  }

  .hero-copy > :nth-child(3) {
    animation-delay: 430ms;
  }

  .hero-portrait-frame {
    animation: hero-portrait-in 1050ms cubic-bezier(0.22, 1, 0.36, 1) 180ms both;
  }

  .parallax-image {
    transform: translate3d(0, var(--parallax-y, 0), 0) scale(1.075);
    transition: transform 90ms linear;
  }

