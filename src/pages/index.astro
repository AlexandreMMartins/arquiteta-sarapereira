---
import { Image } from 'astro:assets';
import Layout from '~/layouts/StudioLayout.astro';
import ContactCTA from '~/components/site/ContactCTA.astro';
import building from '~/assets/images/transformation/building.png';
import remodel from '~/assets/images/services/remodelacao.png';
import architecture from '~/assets/images/services/arquitetura.png';
import consulting from '~/assets/images/services/consultoria.png';
import portrait from '~/assets/images/sobre-v2.png';
const offerings = [
  {
    number: '01',
    title: 'Uma casa para a sua vida.',
    name: 'Arquitetura',
    description: 'Projetos de raiz que nascem do lugar, das suas necessidades e da forma como quer viver.',
    image: architecture,
    href: '/servicos/projetos-arquitetura',
  },
  {
    number: '02',
    title: 'Um novo olhar sobre o existente.',
    name: 'Remodelação e reabilitação',
    description: 'Transformar espaços, melhorar o conforto e valorizar aquilo que os torna únicos.',
    image: remodel,
    href: '/servicos/remodelacao-reabilitacao',
  },
  {
    number: '03',
    title: 'Clareza antes de decidir.',
    name: 'Consultoria e terrenos',
    description: 'Compreender as possibilidades de um imóvel ou terreno antes de dar o próximo passo.',
    image: consulting,
    href: '/servicos/viabilidade-terrenos',
  },
];
---

<Layout
  title="Sara Pereira - Arquiteta em Tomar · Arquitetura e reabilitação"
  description="Arquiteta sediada em Tomar, com projetos noutras localidades. Arquitetura, remodelação, reabilitação e consultoria. Conte-me a sua ideia."
>
  <section class="hero">
    <div class="hero-opening wrap">
      <div class="hero-top">
        <p class="eyebrow">Arquitetura para habitar.</p>
        <h1>
          <span>Espaços com memória.</span><span>Lugar para o <em>futuro.</em></span>
        </h1>
        <p class="hero-description">Arquitetura, remodelação e reabilitação, pensadas à medida de quem habita.</p>
        <div class="actions">
          <a href="/contactos" class="button">Falar sobre o meu projeto</a>
          <a href="/abordagem" class="text-link">Conhecer a abordagem</a>
        </div>
      </div>
      <figure class="hero-image">
        <Image
          src={building}
          alt="Visualização ilustrativa de uma moradia em torno de um pátio, integrada na paisagem"
          widths={[640, 960, 1440, 1920]}
          sizes="(max-width: 760px) 90vw, 56vw"
          loading="eager"
          fetchpriority="high"
          format="webp"
        /><figcaption class="image-note">Visualização arquitetónica ilustrativa.</figcaption>
      </figure>
    </div>
    <div class="hero-bottom wrap">
      <p>A partir de Tomar. Onde o seu projeto nos levar.</p>
      <a href="#servicos" class="hero-discover">Descobrir possibilidades <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="section" id="servicos">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow" style="margin-bottom:24px">01 / O que pretende fazer?</p><h2>
            Cada espaço.<br />Um <em>ponto de partida.</em>
          </h2>
        </div><a href="/servicos" class="text-link">Explorar todos os serviços</a>
      </div><div class="service-grid">
        {
          offerings.map((item) => (
            <a class="service-card" href={item.href}>
              <>
                <span class="number">
                  {item.number} / {item.name}
                </span>
                <Image
                  src={item.image}
                  alt={`Imagem ilustrativa de ${item.name.toLowerCase()}`}
                  widths={[420, 640, 900]}
                  sizes="(max-width:720px) 88vw, 30vw"
                  loading="lazy"
                  format="webp"
                />
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="text-link">Conhecer o serviço</span>
              </>
            </a>
          ))
        }
      </div><p class="image-note" style="margin-top:22px">As imagens desta seleção são ilustrativas dos serviços.</p>
    </div>
  </section>
  <section class="section dark">
    <div class="wrap split">
      <div>
        <p class="eyebrow">Antes do primeiro desenho</p><h2>Um terreno.<br />Muitas <em>perguntas.</em></h2><p>
          Está a pensar comprar um terreno ou transformar um imóvel? A consultoria ajuda a compreender condicionantes,
          organizar prioridades e perceber que informação falta para decidir.
        </p><div class="actions">
          <a href="/servicos/viabilidade-terrenos" class="button button-light">Explorar a consultoria</a>
        </div>
      </div><div>
        <p style="font-family:var(--serif);font-size:clamp(1.9rem,3vw,3rem);line-height:1.45;margin:0">
          “O primeiro passo é perceber<br />o que o lugar pode ser.”
        </p><p style="margin-top:30px">
          Análise do contexto · Leitura de PDM<br />Possibilidades de intervenção · Próximos passos
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow" style="margin-bottom:25px">02 / Como trabalhamos</p><h2>
        Próximos em cada <em>etapa.</em>
      </h2><div class="steps">
        {
          [
            ['01', 'Ouvir', 'Conhecer as suas ideias, o espaço, as prioridades e os recursos disponíveis.'],
            ['02', 'Compreender', 'Ler o lugar e o existente, identificar condicionantes e definir o caminho.'],
            ['03', 'Desenhar', 'Dar forma a soluções coerentes, da organização dos espaços aos materiais.'],
            ['04', 'Preparar', 'Desenvolver a informação necessária às fases contratadas do projeto.'],
          ].map(([number, title, description]) => (
            <article class="step">
              <>
                <span>{number}</span>
                <h3>{title}</h3>
                <p>{description}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section" id="sobre" style="border-top:1px solid var(--line)">
    <div class="wrap split">
      <Image
        src={portrait}
        alt="Sara Pereira, arquiteta"
        widths={[420, 640, 900]}
        sizes="(max-width:720px) 88vw, 42vw"
        loading="lazy"
        class="portrait"
        format="webp"
      /><div>
        <p class="eyebrow">03 / Sara Pereira</p><h2>Inovar sem apagar.<br /><em>Transformar com sentido.</em></h2><p>
          A vontade de criar e transformar casas nasceu cedo. A formação em arquitetura e a experiência de Erasmus em
          Veneza reforçaram o respeito pelo que já existe.
        </p><p>
          É desse equilíbrio que parte cada projeto: compreender o lugar, ouvir quem o vai habitar e encontrar espaço
          para uma nova história.
        </p><div class="actions"><a href="/sobre" class="text-link">Conhecer a Sara</a></div>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="wrap">
      <div class="section-heading">
        <div>
          <p class="eyebrow" style="margin-bottom:24px">04 / Antes de avançar</p><h2>
            Boas decisões começam<br />com <em>boas perguntas.</em>
          </h2>
        </div><a href="/guias" class="text-link">Todas as perguntas</a>
      </div><div class="guide-list">
        <a href="/guias/primeira-reuniao-arquiteta" class="guide-row"
          ><span>PRIMEIROS PASSOS</span><h3>O que preparar para a primeira reunião com uma arquiteta?</h3></a
        ><a href="/guias/preparar-remodelacao" class="guide-row"
          ><span>REMODELAÇÃO</span><h3>Por onde começar a remodelação de uma casa?</h3></a
        >
      </div>
    </div>
  </section>
  <div id="contactos"><ContactCTA /></div>
</Layout>
