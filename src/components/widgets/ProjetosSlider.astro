<div 
  x-data="{
    slides: [
      {
        image: 'https://images.unsplash.com/photo-1519389950473-47ba0277781c?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80',
        title: 'Building on modern foundations',
        description: 'Gain a competitive advantage by incorporating industry-leading practices.',
        features: [
          { title: 'Built on top of Astro 5.0', desc: 'Benefiting from the performance and developer-friendly features of this modern static site generator.' },
          { title: 'Styled using Tailwind CSS', desc: 'Facilitating rapid design and consistent styling with this highly popular utility-first CSS framework.' },
          { title: 'Cross-browser compatibility', desc: 'Ensure your website looks and functions consistently across various web browsers, delivering a seamless experience to all users.' }
        ]
      },
      {
        image: 'https://images.unsplash.com/photo-1611462985358-60d3498e0364?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80',
        title: 'Residential Spaces',
        description: 'Creating homes that reflect personality and comfort.',
        features: [
          { title: 'High level of customization', desc: 'Tailor the template effortlessly to match your brands identity and requirements, making your website distinct and saving you time.' },
          { title: 'Energy Efficiency', desc: 'Implementing modern solutions for reduced energy consumption and sustainability.' },
          { title: 'Smart Home Integration', desc: 'Incorporating smart technology for convenience and efficiency.' }
        ]
      },
      {
        image: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80',
        title: 'Sustainable Buildings',
        description: 'Eco-friendly designs that stand the test of time.',
        features: [
          { title: 'Green Materials', desc: 'Using sustainable materials to reduce environmental impact.' },
          { title: 'Efficient Water Use', desc: 'Implementing water-saving solutions to conserve resources.' },
          { title: 'Low Carbon Footprint', desc: 'Designing buildings that minimize emissions and energy waste.' }
        ]
      }
    ],
    activeSlide: 0,
    slideInterval: null,

    startAutoSlide() {
      clearInterval(this.slideInterval);
      this.slideInterval = setInterval(() => this.next(), 8000);
    },

    next() { 
      this.activeSlide = (this.activeSlide + 1) % this.slides.length; 
      this.startAutoSlide();
    },

    prev() { 
      this.activeSlide = (this.activeSlide - 1 + this.slides.length) % this.slides.length; 
      this.startAutoSlide();
    }
  }"
  x-init="startAutoSlide()"
  class="relative w-full max-w-6xl mx-auto overflow-hidden py-10"
>

  <!-- Slider Wrapper -->
<div class="relative flex w-full h-[500px] md:h-[600px] overflow-hidden">
    <template x-for="(slide, index) in slides" :key="index">
      <div class="absolute flex w-full h-full items-center justify-between transition-all duration-700 ease-in-out"
        :class="activeSlide === index ? 'opacity-100 translate-x-0' : 'opacity-0 translate-x-full'">
        
        <!-- Image (Left) -->
        <div class="w-1/2 h-full">
          <img :src="slide.image" :alt="slide.title"
            class="w-full h-full object-cover rounded-lg"
            loading="lazy"
          />
        </div>

        <!-- Text Content (Right) -->
        <div class="w-1/2 px-6 transition-opacity duration-700 ease-in-out"
          :class="activeSlide === index ? 'opacity-100' : 'opacity-0'">
          <h3 class="text-3xl font-bold text-gray-800 dark:text-white" x-text="slide.title"></h3>
          <p class="mt-2 text-lg text-gray-600 dark:text-gray-300" x-text="slide.description"></p>
          
          <!-- Features List -->
          <ul class="mt-4 space-y-2">
            <template x-for="feature in slide.features" :key="feature.title">
              <li class="flex items-start space-x-2">
                <span class="text-green-500 text-xl">✔</span>
                <div>
                  <h4 class="text-lg font-semibold text-gray-800 dark:text-white" x-text="feature.title"></h4>
                  <p class="text-gray-600 dark:text-gray-300" x-text="feature.desc"></p>
                </div>
              </li>
            </template>
          </ul>

        </div>

      </div>
    </template>
  </div>

  <!-- Navigation Buttons -->
  <button @click="prev()"
    class="absolute left-2 top-1/2 transform -translate-y-1/2 p-3 bg-gray-800 text-white rounded-full shadow-md hover:bg-gray-900">
    ◀
  </button>
  <button @click="next()"
    class="absolute right-2 top-1/2 transform -translate-y-1/2 p-3 bg-gray-800 text-white rounded-full shadow-md hover:bg-gray-900">
    ▶
  </button>

  <!-- Dots Pagination -->
  <div class="absolute bottom-3 left-1/2 transform -translate-x-1/2 flex space-x-2">
    <template x-for="(_, index) in slides">
      <button @click="activeSlide = index; startAutoSlide()"
        class="w-3 h-3 rounded-full transition-all duration-300"
        :class="activeSlide === index ? 'bg-white scale-110' : 'bg-gray-500'">
      </button>
    </template>
  </div>
</div>
